# Opsiyonel — anahtarsiz da calisir (Deezer + iTunes + autocomplete).
# Spotify: https://developer.spotify.com/dashboard (bedava)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3: https://console.cloud.google.com (bedava 10k unit/gun)
YOUTUBE_API_KEY=
# Last.fm: https://www.last.fm/api/account/create (bedava, aninda)
LASTFM_API_KEY=
# Hermes web-arastirma botu (Hetzner SSH) — curator iletisim zenginlestirme
HERMES_SSH_HOST=
HERMES_SSH_USER=root
HERMES_SSH_PASSWORD=
# Pilot kredi yukleme anahtari (POST /admin/credits/grant, X-Admin-Key basligi)
MARKETPLACE_ADMIN_KEY=
# AI reklam spotu metni (Anthropic-uyumlu /v1/messages). Bos ise sablon fallback.
# Varsayilan Anthropic; z.ai coding API icin asagidakileri doldur:
LLM_API_URL=https://api.z.ai/api/anthropic/v1/messages
LLM_MODEL=glm-5.2
LLM_API_KEY=
